rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function extractRolFromDoc(data) {
      return ('rol' in data && data.rol is string)
        ? data.rol.lower()
        : (('Rol' in data && data.Rol is string)
          ? data.Rol.lower()
          : (('role' in data && data.role is string) ? data.role.lower() : 'visor'));
    }

    // Rol del usuario desde usuarios/{uid} o usuarios/{email}, insensible a mayúsculas/minúsculas.
    function rol() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? extractRolFromDoc(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data)
        : (exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower()))
          ? extractRolFromDoc(get(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower())).data)
          : (exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
            ? extractRolFromDoc(get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data)
            : 'visor'));
    }

    // Cuenta principal siempre admin (evita quedarse sin acceso si falta su documento de rol)
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email.lower() == 'sistemas@sotrauraba.com.co' ||
        rol() == 'admin' ||
        rol() == 'administrador'
      );
    }

    function canUpload() {
      return signedIn() && (
        isAdmin() ||
        rol() == 'operador' ||
        rol() == 'operario' ||
        rol() == 'operaciones'
      );
    }

    // Lectura permitida a usuarios autenticados para resolver su rol (por uid, email o campo)
    match /usuarios/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /viajes/{viajeId} {
      allow read: if signedIn();
      allow create, update: if canUpload();
      allow delete: if isAdmin();
    }

    match /telemetria/{telemetriaId} {
      allow read: if signedIn();
      allow create, update: if canUpload();
      allow delete: if isAdmin();
    }

    match /resumen_diario/{fecha} {
      allow read: if signedIn();
      allow create, update: if canUpload();
      allow delete: if isAdmin();
    }

    // Registro de quién subió cada archivo (inmutable)
    match /cargas/{cargaId} {
      allow read: if isAdmin();
      allow create: if canUpload();
      allow update, delete: if false;
    }
  }
}
